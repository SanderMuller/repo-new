#!/usr/bin/env php
<?php declare(strict_types=1);

// Resolve autoloader: project-local first, then composer-global install.
$candidates = [
    __DIR__ . '/../vendor/autoload.php',       // local clone / dev
    __DIR__ . '/../../../autoload.php',         // composer global / project install
];

foreach ($candidates as $candidate) {
    if (file_exists($candidate)) {
        require $candidate;
        break;
    }
}

if (! class_exists(\SanderMuller\RepoNew\Application::class)) {
    fwrite(STDERR, "Could not locate autoload.php. Did you run composer install?\n");
    exit(70);
}

// Self-sync bundled AI skills to user scope on first run after install
// (sentinel-gated per-version, honors BOOST_SKIP_AUTOSYNC). Idempotent and
// silent on a no-op; failures emit a one-line stderr warning and never
// block the CLI.
\SanderMuller\BoostCore\Scripts\BoostAutoSync::syncUserScopeOnce(
    dirname(__DIR__),
    'sandermuller/repo-new',
);

$app = new \SanderMuller\RepoNew\Application();
exit($app->run());
